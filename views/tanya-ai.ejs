<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Tanya AI Toko Sembako Ariesta - tanyakan stok, harga, jam buka, dan ongkir"
    />
    <title><%= title %> | Toko Sembako Ariesta</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="container section">
      <section class="page-head text-center">
        <h1>Tanya AI Ariesta</h1>
        <p>
          Tanyakan stok, harga, jam buka, ongkir, atau cara pembayaran — kami
          siap menjawab otomatis.
        </p>
      </section>

      <section class="chat-card">
        <div class="chat-body" id="chatBody" aria-live="polite"></div>
        <form class="chat-form" id="chatForm">
          <label for="chatInput" class="visually-hidden">Pertanyaan Anda</label>
          <input
            id="chatInput"
            name="message"
            type="text"
            class="form-control"
            placeholder="Ketik pertanyaan, contoh: gula sekilo berapa?"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-custom">Kirim</button>
        </form>
        <p class="chat-note">
          Mode demo: jawaban dihasilkan logika backend (dummy), bukan API AI
          eksternal.
        </p>
      </section>

      <aside class="chat-suggest">
        <h2 class="h6">Coba tanyakan:</h2>
        <button type="button" class="btn btn-sm btn-outline-custom suggestion">
          Buka jam berapa?
        </button>
        <button
          type="button"
          class="btn btn-sm btn-outline-custom suggestion"
        >
          Bisa antar kemana saja?
        </button>
        <button
          type="button"
          class="btn btn-sm btn-outline-custom suggestion"
        >
          Cara bayarnya apa saja?
        </button>
      </aside>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
  </body>
</html>