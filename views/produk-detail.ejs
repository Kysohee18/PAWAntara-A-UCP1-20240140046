<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Toko Sembako Ariesta</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="container py-5">
      <% if (product) { %>
      <article class="product-detail">
        <div class="detail-meta">
          <span class="badge category-badge"><%= product.category %></span>
          <span class="badge stock-badge <%= product.stock > 0 ? 'bg-success' : 'bg-danger' %>">
            Stok: <%= product.stock %>
          </span>
        </div>
        <h1><%= product.name %></h1>
        <p class="detail-price">Rp <%= product.price.toLocaleString('id-ID') %></p>
        <dl class="detail-info">
          <div class="detail-row">
            <dt>Kategori</dt>
            <dd><%= product.category %></dd>
          </div>
          <div class="detail-row">
            <dt>Stok</dt>
            <dd><%= product.stock %> satuan</dd>
          </div>
          <div class="detail-row">
            <dt>ID Produk</dt>
            <dd><%= product.id %></dd>
          </div>
        </dl>
        <p>
          Harga dan stok dapat berubah sewaktu-waktu. Silakan konfirmasi
          melalui fitur <a href="/tanya-ai">Tanya AI</a> atau WhatsApp kami
          untuk kepastian.
        </p>
        <a href="/produk" class="btn btn-custom">Kembali ke Daftar Produk</a>
      </article>
      <% } else { %>
        <article class="empty-state">
          <h1>Produk tidak ditemukan</h1>
          <p>
            Maaf, produk dengan ID yang Anda cari tidak tersedia di toko kami.
          </p>
          <a href="/produk" class="btn btn-custom">Lihat Semua Produk</a>
        </article>
      <% } %>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
  </body>
</html>