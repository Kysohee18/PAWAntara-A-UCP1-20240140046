<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Daftar produk sembako Toko Sembako Ariesta dengan filter kategori dan pencarian"
    />
    <title><%= title %> | Toko Sembako Ariesta</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main>
      <section class="page-head">
        <div class="container">
          <h1>Daftar Produk</h1>
          <p>
            Total <%= total %> produk &middot; menampilkan <%= products.length %>
            hasil
          </p>
        </div>
      </section>

      <section class="container py-4">
        <form class="filter-bar" method="get" action="/produk" role="search">
          <label for="kategori" class="visually-hidden">Filter kategori</label>
          <select id="kategori" name="kategori" class="form-select">
            <option value="">Semua Kategori</option>
            <% categories.forEach(function (c) { %>
            <option value="<%= c %>" <%= kategori.toLowerCase() === c.toLowerCase() ? 'selected' : '' %>>
              <%= c %>
            </option>
            <% }) %>
          </select>
          <label for="search" class="visually-hidden">Cari produk</label>
          <input
            id="search"
            name="search"
            type="search"
            class="form-control"
            placeholder="Cari produk, contoh: beras"
            value="<%= search %>"
          />
          <button type="submit" class="btn btn-custom">Filter</button>
          <% if (kategori || search) { %>
          <a href="/produk" class="btn btn-outline-secondary">Reset</a>
          <% } %>
        </form>

        <% if (products.length === 0) { %>
        <article class="empty-state">
          <h2>Produk tidak ditemukan</h2>
          <p>
            Coba ubah kata kunci pencarian atau pilih kategori lain.
          </p>
          <a href="/produk" class="btn btn-custom">Tampilkan Semua</a>
        </article>
        <% } else { %>
        <div class="row g-4">
          <% products.forEach(function (p) { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <article class="card product-card h-100">
              <div class="card-body">
                <span class="badge category-badge"><%= p.category %></span>
                <h2 class="h6 mt-2"><%= p.name %></h2>
                <p class="price">Rp <%= p.price.toLocaleString('id-ID') %></p>
                <p class="text-muted small mb-2">
                  Stok: <%= p.stock %> &middot; per satuan
                </p>
                <a
                  href="/produk/<%= p.id %>"
                  class="btn btn-sm btn-outline-custom"
                  >Lihat Detail</a
                >
              </div>
            </article>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
  </body>
</html>